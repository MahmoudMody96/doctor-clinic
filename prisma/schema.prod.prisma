// نسخة الإنتاج — PostgreSQL (النسخة المحلية للتطوير هي schema.prisma بـ SQLite)
// الاستخدام في Coolify:
//   build: npx prisma generate --schema prisma/schema.prod.prisma && next build
//   start: prisma db push --schema prisma/schema.prod.prisma --skip-generate && node prisma/seed.mjs && next start

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  displayName  String   @default("مدير النظام")
  createdAt    DateTime @default(now())
}

model Service {
  id          Int       @id @default(autoincrement())
  name        String
  description String
  price       Int
  durationMin Int       @default(30)
  icon        String    @default("Stethoscope")
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  bookings    Booking[]
  createdAt   DateTime  @default(now())
}

// dayOfWeek: 0 = الأحد ... 6 = السبت (توافق Date.getDay)
model ScheduleRule {
  id         Int      @id @default(autoincrement())
  dayOfWeek  Int      @unique
  startTime  String   @default("10:00")
  endTime    String   @default("21:00")
  breakStart String?
  breakEnd   String?
  isActive   Boolean  @default(true)
}

model BlockedDate {
  id     Int     @id @default(autoincrement())
  date   String  @unique
  reason String?
}

model Booking {
  id          Int      @id @default(autoincrement())
  refCode     String   @unique
  patientName String
  phone       String
  serviceId   Int
  service     Service  @relation(fields: [serviceId], references: [id])
  date        String
  time        String
  status      String   @default("PENDING")
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
}

model SiteContent {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String
}
