{
  "name": "clinic",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:push": "prisma db push",
    "db:push:prod": "prisma db push --schema prisma/schema.prod.prisma --skip-generate",
    "db:seed": "node prisma/seed.mjs",
    "db:generate:prod": "prisma generate --schema prisma/schema.prod.prisma",
    "build:prod": "npm run db:generate:prod && next build",
    "start:prod": "npm run db:push:prod && npm run db:seed && npm run start"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.4.0",
    "framer-motion": "^13.1.0",
    "jose": "^6.2.9",
    "lucide-react": "^1.31.0",
    "next": "15.5.23",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "^3.10.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.23",
    "prisma": "^6.19.3",
    "puppeteer-core": "^25.7.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
